{
  "name": "qiyu",
  "private": true,
  "version": "1.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4175 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "models:optimize": "node --import tsx scripts/optimize-models.mjs",
    "models:stage": "node --import tsx scripts/optimize-models.mjs --authoring",
    "models:world": "node scripts/build-world.mjs rebuild",
    "models:world:export": "node scripts/build-world.mjs",
    "models:boat": "node scripts/build-boat.mjs",
    "models:shore-plants": "node scripts/build-shore-plants.mjs",
    "posters:capture": "node --import tsx scripts/design/capture-posters.mjs",
    "check:budget": "node scripts/check-scene-release.mjs",
    "check:release": "node scripts/check-scene-release.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "pixi.js": "^8.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "suncalc": "2.1.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "meshoptimizer": "1.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
